generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

enum DepartmentRole {
  MANAGER
  EMPLOYEE
}

enum CampaignStatus {
  DRAFT
  INITIAL_MAPPING
  ACTIVE
  REVIEW_WINDOW
  LOCKED
  ANALYSIS_IN_PROGRESS
  MANAGER_REVIEW
  FINAL
  ARCHIVED
  CANCELLED
}

enum PeriodStartKind {
  INITIAL
  LATE_JOIN
  RESTORED
}

enum RemovalMode {
  STOP_KEEP_DATA
  EXCLUDE_DATA
}

enum ParticipantStatus {
  ACTIVE
  // Stopped: no future participation, existing data stays in the analysis.
  STOPPED
  // Excluded: participant and their data are left out of the Final Analysis.
  EXCLUDED
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  AD_HOC
}

enum OutputRecipient {
  MANAGER
  OTHER_DEPARTMENT
  CUSTOMER
  AUTHORITY
  EXTERNAL_PARTY
  SYSTEM
  SELF
  UNKNOWN
  OTHER
}

enum AutomationLevel {
  MANUAL
  PARTIAL
  AUTOMATED
}

enum Degree {
  LOW
  MEDIUM
  HIGH
}

enum ExceptionFrequency {
  RARE
  OCCASIONAL
  FREQUENT
  ALMOST_EVERY_CASE
  NOT_SURE
}

enum OccurrenceLevel {
  NONE
  SOMETIMES
  OFTEN
}

enum Seasonality {
  EVEN
  START_OF_MONTH
  END_OF_MONTH
  QUARTER_END
  YEAR_END
  OTHER
}

enum SensitiveCategory {
  PERSONAL
  HEALTH
  FINANCIAL
  CONFIDENTIAL
  CREDENTIALS
  OTHER
  NONE
}

enum ActivitySource {
  DIRECT
  IMPORT
}

enum ImportBatchStatus {
  COMPLETED
}

enum DiaryCondition {
  NORMAL
  WAITING
  REWORK
  PROBLEM
}

enum DiarySource {
  MANUAL
  TIMER
  FAVORITE
  LOG_AGAIN
  QUICK_ADD
  MEETING
}

enum DiaryEntryKind {
  ACTIVITY
  MEETING
}

enum MeetingRecurrence {
  RECURRING
  AD_HOC
}

enum MeetingPurpose {
  INFORMATION_SHARING
  DECISION_MAKING
  PROBLEM_SOLVING
  PLANNING
  OTHER
}

model Organization {
  id                 String             @id @default(cuid())
  name               String
  createdAt          DateTime           @default(now())
  departments        Department[]
  users              User[]
  auditLogs          AuditLog[]
  campaigns          AnalysisCampaign[]
  activityCategories ActivityCategory[]
  volumeUnits        VolumeUnit[]
  systemReferences   SystemReference[]
}

model Department {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id])
  memberships    DepartmentMembership[]
  auditLogs      AuditLog[]
  campaigns      AnalysisCampaign[]

  @@unique([organizationId, name])
}

model User {
  id                  String                    @id @default(cuid())
  organizationId      String
  email               String                    @unique
  firstName           String
  lastName            String
  // Display name, kept in sync with firstName + lastName by the user service.
  name                String
  isOrgAdmin          Boolean                   @default(false)
  active              Boolean                   @default(true)
  locale              String                    @default("en")
  createdAt           DateTime                  @default(now())
  organization        Organization              @relation(fields: [organizationId], references: [id])
  memberships         DepartmentMembership[]
  auditLogs           AuditLog[]                @relation("AuditActor")
  participations      CampaignParticipant[]
  acknowledgements    CampaignAcknowledgement[]
  reminderPreferences ReminderPreference[]
}

// Partial unique indexes (one active membership per user, one active manager
// per department) are added in the migration SQL; Prisma cannot express them.
model DepartmentMembership {
  id           String         @id @default(cuid())
  userId       String
  departmentId String
  role         DepartmentRole
  active       Boolean        @default(true)
  startedAt    DateTime       @default(now())
  endedAt      DateTime?
  user         User           @relation(fields: [userId], references: [id])
  department   Department     @relation(fields: [departmentId], references: [id])

  @@index([departmentId, active])
  @@index([userId, active])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  departmentId   String?
  campaignId     String?
  actorId        String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  department     Department?  @relation(fields: [departmentId], references: [id])
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
}

// A department may have only one campaign in INITIAL_MAPPING, ACTIVE or
// REVIEW_WINDOW at a time. Enforced by a partial unique index in the migration SQL.
model AnalysisCampaign {
  id                      String                    @id @default(cuid())
  organizationId          String
  departmentId            String
  name                    String
  startDate               DateTime                  @db.Date
  endDate                 DateTime                  @db.Date
  reviewWindowDays        Int                       @default(2)
  retrospectiveWindowDays Int                       @default(3)
  reminderTime            String                    @default("16:00")
  reminderMessage         String                    @default("Check whether today's material activities have been recorded.")
  status                  CampaignStatus            @default(DRAFT)
  createdById             String
  launchedAt              DateTime?
  lockedAt                DateTime?
  retentionSnapshot       Json?
  createdAt               DateTime                  @default(now())
  organization            Organization              @relation(fields: [organizationId], references: [id])
  department              Department                @relation(fields: [departmentId], references: [id])
  participants            CampaignParticipant[]
  acknowledgements        CampaignAcknowledgement[]
  reminderPreferences     ReminderPreference[]

  @@index([departmentId, status])
}

model CampaignParticipant {
  id                           String                            @id @default(cuid())
  campaignId                   String
  userId                       String
  // Observation for this participant starts here (campaign start, or the join date for late participants).
  joinedAt                     DateTime                          @db.Date
  status                       ParticipantStatus                 @default(ACTIVE)
  removedAt                    DateTime?
  removedById                  String?
  campaign                     AnalysisCampaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user                         User                              @relation(fields: [userId], references: [id])
  excludedDates                CampaignParticipantExcludedDate[]
  periods                      CampaignParticipationPeriod[]
  // Set when the participant completes Initial Activity Mapping; activity versions then become the baseline.
  mappingCompletedAt           DateTime?
  // Stable identity of the completed baseline (hash of every activity's first version) and its size.
  mappingBaselineHash          String?
  mappingBaselineActivityCount Int?
  importBatches                InitialMappingImportBatch[]
  activities                   InitialActivity[]
  diaryEntries                 DiaryEntry[]
  favorites                    FavoriteActivity[]
  timer                        DiaryTimer?
  diaryConfirmation            DiaryConfirmation?

  @@unique([campaignId, userId])
}

// Out of Scope / Absent dates. No reason is collected.
model CampaignParticipantExcludedDate {
  id            String              @id @default(cuid())
  participantId String
  date          DateTime            @db.Date
  createdById   String
  createdAt     DateTime            @default(now())
  participant   CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, date])
}

// Informational acknowledgement of "About This Analysis" (not legal consent).
model CampaignAcknowledgement {
  id             String           @id @default(cuid())
  campaignId     String
  userId         String
  textVersion    String
  acknowledgedAt DateTime         @default(now())
  campaign       AnalysisCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
}

model ReminderPreference {
  id         String           @id @default(cuid())
  campaignId String
  userId     String
  time       String
  enabled    Boolean          @default(true)
  campaign   AnalysisCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
}

// History of when a participant was actively part of the campaign. A removal closes
// the open period; a restoration opens a new one. Rows are never deleted or rewritten
// except to close the open period, so the interruption stays understandable.
// Active over [startDate, inactiveFrom); inactiveFrom is the first inactive day.
// At most one open period per participant: partial unique index in the migration SQL.
model CampaignParticipationPeriod {
  id            String              @id @default(cuid())
  participantId String
  startDate     DateTime            @db.Date
  startedKind   PeriodStartKind
  startedById   String?
  startedAt     DateTime            @default(now())
  inactiveFrom  DateTime?           @db.Date
  endMode       RemovalMode?
  endedById     String?
  endedAt       DateTime?
  participant   CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, startDate])
}

// Standard categories have departmentId = null; Organization Admins can add department-specific ones.
// The same definition text feeds the Activity Category Guide and (later) AI classification.
model ActivityCategory {
  id                 String                   @id @default(cuid())
  organizationId     String
  departmentId       String?
  nameEn             String
  nameEt             String
  definition         String
  belongsHere        String
  notBelongsHere     String
  boundaryExamples   String?
  // Estonian content. The columns above are the English text; a missing Estonian text falls back to English.
  definitionEt       String?
  belongsHereEt      String?
  notBelongsHereEt   String?
  boundaryExamplesEt String?
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  organization       Organization             @relation(fields: [organizationId], references: [id])
  versions           InitialActivityVersion[]

  @@unique([organizationId, departmentId, nameEn])
}

model VolumeUnit {
  id             String                   @id @default(cuid())
  organizationId String
  key            String
  nameEn         String
  nameEt         String
  active         Boolean                  @default(true)
  organization   Organization             @relation(fields: [organizationId], references: [id])
  versions       InitialActivityVersion[]
  diaryEntries   DiaryEntry[]

  @@unique([organizationId, key])
}

model SystemReference {
  id             String                   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean                  @default(true)
  organization   Organization             @relation(fields: [organizationId], references: [id])
  versions       InitialActivityVersion[]
  diaryEntries   DiaryEntry[]

  @@unique([organizationId, name])
}

// One recurring activity of one participant in one campaign. Its content lives in versions.
model InitialActivity {
  id            String                     @id @default(cuid())
  campaignId    String
  participantId String
  createdAt     DateTime                   @default(now())
  source        ActivitySource             @default(DIRECT)
  importBatchId String?
  importBatch   InitialMappingImportBatch? @relation(fields: [importBatchId], references: [id])
  participant   CampaignParticipant        @relation(fields: [participantId], references: [id], onDelete: Cascade)
  versions      InitialActivityVersion[]
  diaryEntries  DiaryEntry[]
  favorites     FavoriteActivity[]

  @@index([campaignId, participantId])
}

// While the mapping is a draft, version 1 is edited in place. Completing the mapping marks
// version 1 as the baseline; later edits add a new version and never overwrite the baseline.
model InitialActivityVersion {
  id                     String              @id @default(cuid())
  activityId             String
  versionNumber          Int
  isBaseline             Boolean             @default(false)
  createdById            String
  createdAt              DateTime            @default(now())
  name                   String
  description            String
  purpose                String
  outputRecipient        OutputRecipient
  outputRecipientNote    String?
  primaryCategoryId      String
  tags                   String[]
  frequency              Frequency
  // Occurrences per frequency period (for AD_HOC: per month).
  occurrenceCount        Int
  avgDurationMinutes     Int
  volume                 Float?
  volumeUnitId           String?
  automationLevel        AutomationLevel
  ruleBasedDegree        Degree
  judgementDegree        Degree
  exceptionFrequency     ExceptionFrequency
  dataManuallyCopied     Boolean
  needsInfoFromOthers    Boolean
  waiting                OccurrenceLevel
  rework                 OccurrenceLevel
  seasonality            Seasonality
  sensitiveData          SensitiveCategory[]
  improvementOpportunity Boolean             @default(false)
  employeeSuggestion     String?
  activity               InitialActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  primaryCategory        ActivityCategory    @relation(fields: [primaryCategoryId], references: [id])
  volumeUnit             VolumeUnit?         @relation(fields: [volumeUnitId], references: [id])
  systems                SystemReference[]

  @@unique([activityId, versionNumber])
}

// One confirmed import of a completed template. Nothing is written before the participant confirms,
// so only completed batches exist. The raw uploaded file is never stored.
model InitialMappingImportBatch {
  id               String              @id @default(cuid())
  campaignId       String
  participantId    String
  // Client-held key created at preview time: a repeated confirmation of the same preview cannot import twice.
  idempotencyKey   String
  // Hash of the confirmed rows: importing the same content again is detected.
  contentHash      String
  status           ImportBatchStatus   @default(COMPLETED)
  importedAt       DateTime            @default(now())
  templateVersion  String
  templateLanguage String
  sourceFilename   String?
  rowCount         Int
  successCount     Int
  warningCount     Int
  errorCount       Int
  participant      CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  activities       InitialActivity[]

  @@unique([participantId, idempotencyKey])
  @@index([participantId, contentHash])
}

// One actual piece of work (or a meeting) a participant logged for one date. Only the owner reads or
// writes it. `title` is a snapshot of the activity name, so an entry stays readable even if the mapped
// activity is later removed. A free-text entry has no initialActivityId.
model DiaryEntry {
  id                     String              @id @default(cuid())
  campaignId             String
  participantId          String
  kind                   DiaryEntryKind      @default(ACTIVITY)
  activityDate           DateTime            @db.Date
  initialActivityId      String?
  title                  String
  durationMinutes        Int
  // Optional clock times as minutes since midnight. Explicit times may overlap other entries (parallel work).
  startMinute            Int?
  endMinute              Int?
  volume                 Float?
  volumeUnitId           String?
  condition              DiaryCondition      @default(NORMAL)
  interrupted            Boolean             @default(false)
  outOfScope             Boolean             @default(false)
  note                   String?
  improvementOpportunity Boolean             @default(false)
  employeeSuggestion     String?
  source                 DiarySource         @default(MANUAL)
  meetingRecurrence      MeetingRecurrence?
  meetingPurpose         MeetingPurpose?
  sharedMeetingId        String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  participant            CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  initialActivity        InitialActivity?    @relation(fields: [initialActivityId], references: [id], onDelete: SetNull)
  volumeUnit             VolumeUnit?         @relation(fields: [volumeUnitId], references: [id])
  sharedMeeting          SharedMeeting?      @relation(fields: [sharedMeetingId], references: [id], onDelete: SetNull)
  systems                SystemReference[]

  // A participant can add a given shared meeting to their own diary only once.
  @@unique([participantId, sharedMeetingId])
  @@index([participantId, activityDate])
}

// A meeting defined once so several participants can each add it to their own diary without double counting.
model SharedMeeting {
  id              String            @id @default(cuid())
  campaignId      String
  createdById     String
  title           String
  meetingDate     DateTime          @db.Date
  durationMinutes Int
  recurrence      MeetingRecurrence
  purpose         MeetingPurpose
  note            String?
  createdAt       DateTime          @default(now())
  entries         DiaryEntry[]

  @@index([campaignId, meetingDate])
}

model FavoriteActivity {
  id                String              @id @default(cuid())
  participantId     String
  initialActivityId String
  createdAt         DateTime            @default(now())
  participant       CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  initialActivity   InitialActivity     @relation(fields: [initialActivityId], references: [id], onDelete: Cascade)

  @@unique([participantId, initialActivityId])
}

// At most one running timer per participant. It is stored on the server, so a refresh does not lose it,
// and it is never stopped automatically.
model DiaryTimer {
  id                String              @id @default(cuid())
  participantId     String              @unique
  campaignId        String
  initialActivityId String?
  title             String
  startedAt         DateTime            @default(now())
  // Set when the participant stops the timer and is reviewing the duration.
  stoppedAt         DateTime?
  participant       CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model DiaryConfirmation {
  id            String              @id @default(cuid())
  campaignId    String
  participantId String              @unique
  confirmedAt   DateTime            @default(now())
  participant   CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}
